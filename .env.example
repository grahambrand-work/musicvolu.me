# Copy to .env.local for running on your own computer. On the server these are set in
# Coolify (the site > Environment Variables).

# The Noteworthy database (the Postgres inside Supabase). Musicvolu.me reads the catalog
# from the public schema; its own tables will live in the musicvolume schema.
DATABASE_URL=postgres://user:password@host:5432/postgres

# Pre-launch password screen. Leave empty to open the site to everyone.
SITE_ACCESS_PASSWORD=
